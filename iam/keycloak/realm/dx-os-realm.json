{
  "realm": "dx-os",
  "enabled": true,
  "displayName": "DX-OS Lab",
  "loginTheme": "dx-os",
  "internationalizationEnabled": true,
  "supportedLocales": ["vi", "en"],
  "defaultLocale": "vi",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      { "name": "employee", "description": "Create and track own requests" },
      { "name": "department_manager", "description": "Review department requests" },
      { "name": "finance", "description": "Validate budget and finance rules" },
      { "name": "dx_admin", "description": "Administer DX-OS integration" },
      { "name": "auditor", "description": "Read-only access to evidence and audit" },
      { "name": "ai_operator", "description": "Review AI recommendations and tool calls" }
    ]
  },
  "groups": [
    { "name": "employees", "realmRoles": ["employee"] },
    { "name": "department-managers", "realmRoles": ["department_manager"] },
    { "name": "finance", "realmRoles": ["finance"] },
    { "name": "auditors", "realmRoles": ["auditor"] }
  ],
  "clients": [
    {
      "clientId": "dx-web",
      "name": "DX-OS Angular Web",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:4200/*"],
      "webOrigins": ["http://localhost:4200"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "dx-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "dx-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "dx-api",
      "name": "DX-OS Go API",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ]
}
