# Image baseline verified on 2026-07-29. Upgrade through an explicit review.
POSTGRES_IMAGE=postgres:18.4-alpine
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.0
GO_BUILDER_IMAGE=golang:1.26.6-alpine
NODE_BUILDER_IMAGE=node:24.15.0-alpine
NEXTCLOUD_IMAGE=nextcloud:34.0.2-apache
METABASE_IMAGE=metabase/metabase:v0.63.1
NGINX_IMAGE=nginx:1.30.4-alpine
RAGFLOW_VERSION=v0.26.4

# Foundation ports
POSTGRES_HOST_PORT=5432
KEYCLOAK_HOST_PORT=8080
NEXTCLOUD_HOST_PORT=8082
METABASE_HOST_PORT=3000
DOCS_HOST_PORT=4300

# PostgreSQL superuser: local bootstrap only
POSTGRES_ADMIN_USER=dxos_admin
POSTGRES_ADMIN_PASSWORD=CHANGEME-long-random-postgres-admin-password

# Service-specific databases and users
DXOS_DB=dxos
DXOS_DB_USER=dxos_app
DXOS_DB_PASSWORD=CHANGEME-long-random-dxos-db-password

KEYCLOAK_DB=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGEME-long-random-keycloak-db-password

NEXTCLOUD_DB=nextcloud
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_PASSWORD=CHANGEME-long-random-nextcloud-db-password

METABASE_DB=metabase
METABASE_DB_USER=metabase
METABASE_DB_PASSWORD=CHANGEME-long-random-metabase-db-password

# Read-only analytics connection to curated views in the DX-OS database
REPORTING_DB_USER=dxos_report_reader
REPORTING_DB_PASSWORD=CHANGEME-long-random-reporting-readonly-password

# Keycloak bootstrap administrator
KEYCLOAK_ADMIN_USER=dxos-keycloak-admin
KEYCLOAK_ADMIN_PASSWORD=CHANGEME-long-random-keycloak-admin-password

# Go API / Angular public OIDC settings
API_HOST_PORT=8081
WEB_HOST_PORT=4200
OIDC_ISSUER=http://localhost:8080/realms/dx-os
OIDC_WEB_CLIENT_ID=dx-web
OIDC_API_AUDIENCE=dx-api

# Nextcloud service account used only by the Go API. Generate unique values.
NEXTCLOUD_ADMIN_USER=dxos-nextcloud-admin
NEXTCLOUD_ADMIN_PASSWORD=CHANGEME-long-random-nextcloud-admin-password
NEXTCLOUD_ROOT=DX-OS
METABASE_ENCRYPTION_SECRET_KEY=CHANGEME-at-least-16-characters
